{
  "name": "gullbur-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "xvfb-run --auto-servernum --server-args=\"-screen 0 1280x720x24\" npx tauri dev",
    "tauri:build": "npx tauri build",
    "tauri:test": "xvfb-run --auto-servernum --server-args=\"-screen 0 1280x720x24\" npx tauri build",
    "tauri:relay": "cargo build --bin gullbur-relay --release",
    "tauri:package": "cargo build --bin gullbur-relay --release && npx tauri build && bash ../../scripts/package-extension.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.1",
    "@tauri-apps/plugin-biometric": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.0",
    "rollup": "^4.14.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
