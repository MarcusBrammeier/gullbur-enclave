{
  "name": "gullbur-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "xvfb-run --auto-servernum --server-args=\"-screen 0 1280x720x24\" npx tauri dev",
    "tauri:build": "npx tauri build",
    "tauri:test": "xvfb-run --auto-servernum --server-args=\"-screen 0 1280x720x24\" npx tauri build",
    "tauri:relay": "cargo build --bin gullbur-relay --release",
    "tauri:package": "cargo build --bin gullbur-relay --release && npx tauri build && bash ../../scripts/package-extension.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.1",
    "@tauri-apps/plugin-biometric": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "qrcode": "^1.5.4",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
