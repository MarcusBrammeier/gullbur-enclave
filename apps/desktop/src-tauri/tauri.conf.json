{
  "$schema": "https://raw.githubusercontent.com/nicholasio/vsce-format/main/schemas/tauri-v2.json",
  "productName": "Gullbúr Enclave",
  "version": "0.0.2",
  "identifier": "com.gullbur.enclave",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gullbúr Enclave",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'inline-speculation-rules'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc://localhost ws://127.0.0.1:* content:; font-src 'self' data:; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "pattern": {
        "use": "brownfield"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libgcrypt20", "libgpg-error0"]
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "usr/lib/libgcrypt.so.20": "local-libs/libgcrypt.so.20",
          "usr/lib/libgpg-error.so.0": "local-libs/libgpg-error.so.0"
        }
      }
    }
  },
  "plugins": {
    "biometric": {
      "reason": "Authenticate to access your crypto vault"
    }
  }
}